# ─── Server ──────────────────────────────────────────────────────────
# Port the API listens on
PORT=3000

# ─── Database ────────────────────────────────────────────────────────
# MongoDB connection string (without the database name at the end: use DB_NAME)
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_URL=mongodb://localhost:27017

# Database name
DB_NAME=Library

# ─── JWT ─────────────────────────────────────────────────────────────
# Two DIFFERENT secrets, one for access tokens and one for refresh tokens.
# Generate them with:  openssl rand -hex 64
# (or:                 node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes. Format accepted by jsonwebtoken/ms:
# s = seconds, m = minutes, h = hours, d = days  (e.g. 20m, 12h, 30d)
EXP_ACCESS_TTL=20m
EXP_REFRESH_TTL=30d
